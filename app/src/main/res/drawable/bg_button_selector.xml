<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused by TV Remote DPAD: Ultra high contrast bright emerald with white inner ring -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#10B981" />
            <corners android:radius="14dp" />
            <stroke android:width="4dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#059669" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#10B981" />
        </shape>
    </item>
    <!-- Default unfocused state: Dark slate card -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E293B" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#334155" />
        </shape>
    </item>
</selector>
