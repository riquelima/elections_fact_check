<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/background_tv"
    android:padding="36dp"
    android:baselineAligned="false">

    <!-- Left Column: Branding, Status & Live Telemetry -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingEnd="32dp">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:src="@drawable/ic_factcheck_logo"
            android:contentDescription="@string/app_name"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_tagline"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="6dp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_tv"
            android:padding="18dp"
            android:layout_marginTop="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS DO SISTEMA"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_service_stopped"
                android:textColor="@color/accent_red"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sistema Ativo • Escuta em Português (pt-BR)"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Right Column: DPAD Menu Options (No API Key field) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card_tv"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAINEL DE CONTROLE DA TV"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="20dp" />

        <!-- Button 1: Toggle Monitoring (Main Action) -->
        <Button
            android:id="@+id/btnToggleService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_start_service"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_selector"
            android:padding="18dp"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="14dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@id/btnTestOverlay" />

        <!-- Button 2: Test Standard Live Overlay -->
        <Button
            android:id="@+id/btnTestOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_test_overlay"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_selector"
            android:padding="16dp"
            android:textStyle="bold"
            android:textSize="13.5sp"
            android:layout_marginBottom="12dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/btnToggleService"
            android:nextFocusDown="@id/btnTestPolitical" />

        <!-- Button 3: Test Political Debate Claim (Lula x Flávio Bolsonaro) -->
        <Button
            android:id="@+id/btnTestPolitical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Testar: Debate Político (Lula x Flávio Bolsonaro)"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_selector"
            android:padding="16dp"
            android:textStyle="bold"
            android:textSize="13.5sp"
            android:layout_marginBottom="12dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/btnTestOverlay"
            android:nextFocusDown="@id/btnGrantOverlay" />

        <!-- Button 4: Grant Overlay Permission -->
        <Button
            android:id="@+id/btnGrantOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_permission_overlay"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_selector"
            android:padding="16dp"
            android:textStyle="bold"
            android:textSize="13sp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/btnTestPolitical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dica: Use as setas do controle remoto para navegar. O botão selecionado ficará iluminado em verde com contorno branco."
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</LinearLayout>
